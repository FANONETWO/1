# Godot 4 编辑器缓存与导入产物（不要提交）
.godot/
/android/

# 导出产物
/build/
/export/
*.pck
*.exe
*.zip

# 系统文件
Thumbs.db
.DS_Store

# 浏览器自动化：登录态与密钥（绝不提交）
.secrets/
.env.local

# 依赖与 AI 生成原图（原图不入库，处理后的成品才入库）
node_modules/
assets/raw/
*.log

# 本地扫描工具状态
.mimosa/

# ——— 联合开发补充 ———
# IDE / 编辑器（每人环境不同，必然无意义冲突）
.vscode/
.idea/
*.swp
*.swo

# 本机路径相关的导出配置
export_presets.cfg

# Godot 写入的用户目录（存档 / 日志）
user://

# ——— 注意 ———
# 资源旁边的 *.import 文件**必须提交**（Godot 靠它引用资源），
# 上面忽略的 .godot/ 只是导入缓存，两者不是一回事。
!*.import

